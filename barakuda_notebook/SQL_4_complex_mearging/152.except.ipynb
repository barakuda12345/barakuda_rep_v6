   "source": [
    "Вычитаем данные одной таблицы из другой\n",
    "```\n",
    "SELECT\n",
    "    c.city_name\n",
    "FROM sql.shipment s\n",
    "JOIN sql.city c ON s.city_id = c.city_id\n",
    "EXCEPT\n",
    "SELECT\n",
    "    cc.city_name\n",
    "FROM sql.driver d\n",
    "JOIN sql.city cc ON d.city_id = cc.city_id\n",
    "ORDER BY 1\n",
    "```"
   ]
  }
 ],
