   "source": [
    "```\n",
    "SELECT\n",
    "    d.first_name,\n",
    "    d.last_name,\n",
    "    'телефон заполнен' phone_info\n",
    "FROM \n",
    "    sql.driver d\n",
    "WHERE sql.phone IS NOT NULL\n",
    "UNION ALL\n",
    "SELECT\n",
    "    d.first_name,\n",
    "    d.last_name,\n",
    "    'телефон не заполнен' phone_info\n",
    "FROM \n",
    "    sql.driver d\n",
    "WHERE sql.phone IS NULL\n",
    "```"
   ]
  }
