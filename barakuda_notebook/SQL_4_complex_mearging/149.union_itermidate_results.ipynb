   "source": [
    "Для получения данных отображаем в резальтате запроса вывод об общей сумме популяции городов\n",
    "```\n",
    "SELECT\n",
    "    c.city_name,\n",
    "    c.population\n",
    "FROM\n",
    "    sql.city c\n",
    "UNION ALL\n",
    "SELECT\n",
    "    'total',\n",
    "    SUM(c.population)\n",
    "FROM\n",
    "    sql.city c\n",
    "ORDER BY 2 DESC\n",
    "```"
   ]
  }
 ],
