   "source": [
    "Объединяются таблицы с разными типами данних, используется приведение к единому типу данных\n",
    "```\n",
    "SELECT \n",
    "    c.city_id::text\n",
    "FROM\n",
    "    sql.city c\n",
    "UNION ALL\n",
    "SELECT\n",
    "    c.city_name\n",
    "FROM\n",
    "    sql.city cc\n",
    "```"
   ]
  }
 ],
